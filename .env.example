# Copy to .env.local and fill in. .env.local is git-ignored.
# Server-only secrets: no prefix.

# Trial form → email from your mailbox to your inbox (see lib/leads.ts).
# Gmail: turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (no spaces).
LEADS_EMAIL_USER=
LEADS_EMAIL_PASSWORD=
# Optional: send to a different inbox (defaults to LEADS_EMAIL_USER).
# LEADS_EMAIL_TO=
# Optional: another provider's SMTP host (defaults to smtp.gmail.com).
# LEADS_SMTP_HOST=
# LEADS_SMTP_PORT=465

# Browser-exposed values must be prefixed with NEXT_PUBLIC_.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
